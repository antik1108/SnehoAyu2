PORT=4000
NODE_ENV=development

# PostgreSQL connection string (consumed by Prisma).
# Local Postgres example:
#   DATABASE_URL="postgresql://snehoayu:snehoayu_dev@localhost:5432/snehoayu"
# Neon (or other hosted Postgres) example:
#   DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"
DATABASE_URL="postgresql://snehoayu:snehoayu_dev@localhost:5432/snehoayu"

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-generated-64-byte-hex-secret

# Token lifetime (ms-parseable string for access, integer days for refresh)
ACCESS_TOKEN_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# ── Dev / Testing ────────────────────────────────────────────────────────────
# Randomly assigns study group during development (never use in production)
ENABLE_DEV_RANDOM_GROUP_ASSIGNMENT=true

# ── bcrypt ───────────────────────────────────────────────────────────────────
BCRYPT_PASSWORD_ROUNDS=12

# ── AI Insights (Groq) ───────────────────────────────────────────────────────
# Get a key at https://console.groq.com/keys — never commit a real key.
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
