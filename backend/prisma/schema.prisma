// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Hospital {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String
  code                  String   @unique
  district              String
  state                 String   @default("West Bengal")
  type                  String
  emergencyPhone        String?
  isActive              Boolean  @default(true)
  nextParticipantNumber Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users          User[]
  motherProfiles MotherProfile[]
  nurseProfiles  NurseProfile[]
}

model User {
  id                     String    @id @default(uuid()) @db.Uuid
  /// Normalised to +91XXXXXXXXXX. Unique username for this app.
  phone                  String    @unique
  phoneVerified          Boolean   @default(false)
  email                  String?   @unique
  passwordHash           String
  pinHash                String?
  role                   String
  preferredLanguage      String    @default("bn")
  hospitalId             String?   @db.Uuid
  isActive               Boolean   @default(true)
  lastLoginAt            DateTime?
  /// Password brute-force protection
  failedPasswordAttempts Int       @default(0)
  passwordLockedUntil    DateTime?
  /// PIN brute-force protection  (used from Day 3 onwards)
  failedPinAttempts      Int       @default(0)
  pinLockedUntil         DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  hospital          Hospital?          @relation(fields: [hospitalId], references: [id])
  motherProfile     MotherProfile?
  nurseProfile      NurseProfile?
  researcherProfile ResearcherProfile?
  refreshTokens     RefreshToken[]
  recordedGrowthReadings GrowthReading[]
  learningArticles  LearningArticle[]

  @@index([phone])
}

// OtpVerification is intentionally preserved but not used in the password-auth
// flow (Day 2). It will remain dormant until an SMS-gateway is integrated.
model OtpVerification {
  id        String    @id @default(uuid()) @db.Uuid
  phone     String
  otpHash   String
  purpose   String
  isUsed    Boolean   @default(false)
  attempts  Int       @default(0)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  deviceInfo String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model MotherProfile {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @unique @db.Uuid
  participantCode      String?            @unique
  studyGroup           String?
  hospitalId           String?            @db.Uuid
  fullName             String?
  ageRange             String
  educationMother      String
  educationFather      String
  occupationMother     String
  occupationFather     String
  incomeClass          String
  familyType           String
  familyMembersCount   String
  religion             String
  residenceType        String
  contactNumber        String?
  prevPretermEducation Boolean            @default(false)
  educationSource      String[]
  enrolledAt           DateTime           @default(now())
  onboardingCompletedAt DateTime?          @map("onboarding_completed_at")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user                 User               @relation(fields: [userId], references: [id])
  hospital             Hospital?          @relation(fields: [hospitalId], references: [id])
  babyProfile          BabyProfile?
  followUpSchedules    FollowUpSchedule[]
  dailyLogs            DailyLog[]
  knowledgeAssessments KnowledgeAssessment[]
  who5Assessments      Who5Assessment[]
  psocAssessments      PsocAssessment[]
  growthReadings       GrowthReading[]
  tdscAssessments      TdscAssessment[]
  vaccineRecords       VaccineRecord[]
  breastfeedingAssessments BreastfeedingAssessment[]
  contentViews         ContentView[]
  videoCallSessions    VideoCallSession[]
  kmcDailyLogs         KmcDailyLog[]
}

model BabyProfile {
  id                     String        @id @default(uuid()) @db.Uuid
  motherProfileId        String        @unique @db.Uuid
  babyName               String?
  sex                    String
  dateOfBirth            DateTime
  gestationalAgeWeeks    Decimal       @db.Decimal(4, 1)
  birthWeightGrams       Int
  weightAtDischargeGrams Int
  placeOfDelivery        String
  nicuStayDays           Int
  skinToSkinAtBirth      Boolean
  kmcInNicu              Boolean
  feedingAtDischarge     String
  criedAtBirth           Boolean
  neededResuscitation    Boolean
  birthWeightStratum     String
  dischargeDate          DateTime
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  motherProfile          MotherProfile @relation(fields: [motherProfileId], references: [id])
  growthReadings         GrowthReading[]
}

model NurseProfile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  hospitalId String   @db.Uuid
  fullName   String
  employeeId String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
}

model ResearcherProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  fullName    String
  designation String?
  email       String   @unique
  accessLevel String   @default("full")
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

model FollowUpSchedule {
  id                String        @id @default(uuid()) @db.Uuid
  motherProfileId   String        @db.Uuid
  timePoint         String
  scheduledDate     DateTime
  actualDate        DateTime?
  status            String        @default("pending")
  dataComplete      Boolean       @default(false)
  collectedByUserId String?       @db.Uuid
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  motherProfile     MotherProfile @relation(fields: [motherProfileId], references: [id])
  knowledgeAssessments KnowledgeAssessment[]
  who5Assessments      Who5Assessment[]
  psocAssessments      PsocAssessment[]

  @@unique([motherProfileId, timePoint])
}

model KnowledgeAssessment {
  id                 String            @id @default(uuid()) @db.Uuid
  motherProfileId    String            @map("mother_profile_id") @db.Uuid
  motherProfile      MotherProfile     @relation(fields: [motherProfileId], references: [id], onDelete: Restrict)
  followUpScheduleId String?           @map("follow_up_schedule_id") @db.Uuid
  followUpSchedule   FollowUpSchedule? @relation(fields: [followUpScheduleId], references: [id], onDelete: SetNull)
  timePoint          String            @map("time_point") @db.VarChar(20)
  responses          Json              @db.JsonB
  score              Int
  maxScore           Int               @default(15) @map("max_score")
  percentage         Int
  grade              String            @db.VarChar(20)
  submittedAt        DateTime          @default(now()) @map("submitted_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@unique([motherProfileId, timePoint])
  @@index([motherProfileId, timePoint])
  @@map("knowledge_assessments")
}

model Who5Assessment {
  id                 String            @id @default(uuid()) @db.Uuid
  motherProfileId    String            @map("mother_profile_id") @db.Uuid
  motherProfile      MotherProfile     @relation(fields: [motherProfileId], references: [id], onDelete: Restrict)
  followUpScheduleId String?           @map("follow_up_schedule_id") @db.Uuid
  followUpSchedule   FollowUpSchedule? @relation(fields: [followUpScheduleId], references: [id], onDelete: SetNull)
  timePoint          String            @map("time_point") @db.VarChar(20)
  responses          Json              @db.JsonB
  rawScore           Int               @map("raw_score")
  maxScore           Int               @default(25) @map("max_score")
  percentageScore    Int               @map("percentage_score")
  poorWellbeingFlag  Boolean           @default(false) @map("poor_wellbeing_flag")
  interpretation     String            @db.VarChar(40)
  submittedAt        DateTime          @default(now()) @map("submitted_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@unique([motherProfileId, timePoint])
  @@index([motherProfileId, timePoint])
  @@map("who5_assessments")
}

model PsocAssessment {
  id                   String            @id @default(uuid()) @db.Uuid
  motherProfileId      String            @map("mother_profile_id") @db.Uuid
  motherProfile        MotherProfile     @relation(fields: [motherProfileId], references: [id], onDelete: Restrict)
  followUpScheduleId   String?           @map("follow_up_schedule_id") @db.Uuid
  followUpSchedule     FollowUpSchedule? @relation(fields: [followUpScheduleId], references: [id], onDelete: SetNull)
  timePoint            String            @map("time_point") @db.VarChar(20)
  rawResponses         Json              @map("raw_responses") @db.JsonB
  scoredResponses      Json              @map("scored_responses") @db.JsonB
  efficacyScore        Int               @map("efficacy_score")
  satisfactionScore    Int               @map("satisfaction_score")
  totalScore           Int               @map("total_score")
  maxScore             Int               @default(102) @map("max_score")
  classification       String?           @db.VarChar(40)
  classificationMethod String?           @map("classification_method") @db.VarChar(80)
  submittedAt          DateTime          @default(now()) @map("submitted_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  @@unique([motherProfileId, timePoint])
  @@index([motherProfileId, timePoint])
  @@map("psoc_assessments")
}

model GrowthReading {
  id                      String        @id @default(uuid()) @db.Uuid
  babyProfileId           String        @map("baby_profile_id") @db.Uuid
  babyProfile             BabyProfile   @relation(fields: [babyProfileId], references: [id], onDelete: Restrict)
  motherProfileId         String        @map("mother_profile_id") @db.Uuid
  motherProfile           MotherProfile @relation(fields: [motherProfileId], references: [id], onDelete: Restrict)
  recordedByUserId        String        @map("recorded_by_user_id") @db.Uuid
  recordedByUser          User          @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)
  readingDate             DateTime      @map("reading_date") @db.Date
  weightGrams             Int           @map("weight_grams")
  lengthCm                Decimal       @map("length_cm") @db.Decimal(5, 2)
  headCircumferenceCm     Decimal       @map("head_circumference_cm") @db.Decimal(5, 2)
  chronologicalAgeDays    Int           @map("chronological_age_days")
  chronologicalAgeWeeks   Decimal       @map("chronological_age_weeks") @db.Decimal(6, 2)
  correctedAgeDays        Int           @map("corrected_age_days")
  correctedAgeWeeks       Decimal       @map("corrected_age_weeks") @db.Decimal(6, 2)
  timePoint               String?       @map("time_point") @db.VarChar(20)
  source                  String        @default("manual") @db.VarChar(30)
  notes                   String?       @db.Text
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  @@unique([babyProfileId, readingDate])
  @@index([motherProfileId, readingDate])
  @@index([babyProfileId, readingDate])
  @@map("growth_readings")
}

model DailyLog {
  id                      String        @id @default(uuid()) @db.Uuid
  motherProfileId         String        @map("mother_profile_id") @db.Uuid
  motherProfile           MotherProfile @relation(fields: [motherProfileId], references: [id], onDelete: Restrict)
  careDate                DateTime      @map("care_date") @db.Date

  breastfeedingDone       Boolean       @default(false) @map("breastfeeding_done")
  breastfeedingFeedsCount Int?          @map("breastfeeding_feeds_count")
  breastfeedingVolumeMl   Int?          @map("breastfeeding_volume_ml")

  kmcDone                 Boolean       @default(false) @map("kmc_done")
  kmcMinutes              Int?          @map("kmc_minutes")

  temperatureMorningC     Decimal?      @map("temperature_morning_c") @db.Decimal(4, 1)
  temperatureEveningC     Decimal?      @map("temperature_evening_c") @db.Decimal(4, 1)
  temperatureDone         Boolean       @default(false) @map("temperature_done")

  weightCheckDone         Boolean       @default(false) @map("weight_check_done")
  weightGrams             Int?          @map("weight_grams")

  skinCordCareDone        Boolean       @default(false) @map("skin_cord_care_done")

  // Phase 3 additions — KB §4.4 Daily Checklist items
  sleepDone               Boolean       @default(false) @map("sleep_done")
  urinationDone           Boolean       @default(false) @map("urination_done")
  urinationCount          Int?          @map("urination_count")
  stoolDone               Boolean       @default(false) @map("stool_done")
  stoolAbnormal           Boolean       @default(false) @map("stool_abnormal")

  medicationDone          Boolean?      @map("medication_done")
  medicationNotes         String?       @map("medication_notes") @db.Text

  dangerSignsReviewed     Boolean       @default(false) @map("danger_signs_reviewed")

  notes                   String?       @db.Text

  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  @@unique([motherProfileId, careDate])
  @@index([motherProfileId, careDate])
  @@map("daily_logs")
}

/// Append-only research-grade audit trail. Never updated or deleted.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role") @db.VarChar(20)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model TdscAssessment {
  id                String        @id @default(uuid()) @db.Uuid
  motherProfileId   String        @map("mother_profile_id") @db.Uuid
  motherProfile     MotherProfile @relation(fields: [motherProfileId], references: [id])
  timePoint         String        @map("time_point") @db.VarChar(20)
  assessmentDate    DateTime      @map("assessment_date") @db.Date
  correctedAgeDays  Int           @map("corrected_age_days")
  results           Json
  suspectedDelay    Boolean       @default(false) @map("suspected_delay")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@unique([motherProfileId, timePoint])
  @@map("tdsc_assessments")
}

model VaccineRecord {
  id                String        @id @default(uuid()) @db.Uuid
  motherProfileId   String        @map("mother_profile_id") @db.Uuid
  motherProfile     MotherProfile @relation(fields: [motherProfileId], references: [id])
  vaccineId         String        @map("vaccine_id") @db.VarChar(50)
  vaccineName       String        @map("vaccine_name") @db.VarChar(150)
  dueDate           DateTime      @map("due_date") @db.Date
  completedDate     DateTime?     @map("completed_date") @db.Date
  batchNumber       String?       @map("batch_number") @db.VarChar(50)
  administeredBy    String?       @map("administered_by") @db.VarChar(150)
  status            String        @default("pending") @db.VarChar(20)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@unique([motherProfileId, vaccineId])
  @@index([motherProfileId, status])
  @@map("vaccine_records")
}

model BreastfeedingAssessment {
  id                String        @id @default(uuid()) @db.Uuid
  motherProfileId   String        @map("mother_profile_id") @db.Uuid
  motherProfile     MotherProfile @relation(fields: [motherProfileId], references: [id])
  timePoint         String        @map("time_point") @db.VarChar(20)
  responses         Json
  totalScore        Int           @map("total_score")
  grade             String        @db.VarChar(20)
  submittedAt       DateTime      @default(now()) @map("submitted_at")

  @@unique([motherProfileId, timePoint])
  @@map("breastfeeding_assessments")
}

model ContentItem {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique @db.VarChar(100)
  category    String        @db.VarChar(50)
  createdAt   DateTime      @default(now()) @map("created_at")

  views       ContentView[]

  @@map("content_items")
}

model ContentView {
  id              String        @id @default(uuid()) @db.Uuid
  motherProfileId String        @map("mother_profile_id") @db.Uuid
  motherProfile   MotherProfile @relation(fields: [motherProfileId], references: [id])
  contentItemId   String        @map("content_item_id") @db.Uuid
  contentItem     ContentItem   @relation(fields: [contentItemId], references: [id])
  viewedAt        DateTime      @default(now()) @map("viewed_at")

  @@unique([motherProfileId, contentItemId])
  @@map("content_views")
}

model CareMessage {
  id          String   @id @default(uuid()) @db.Uuid
  weekNumber  Int      @map("week_number")
  type        String   @db.VarChar(20)
  textBn      String   @map("text_bn") @db.Text
  textHi      String?  @map("text_hi") @db.Text
  textEn      String?  @map("text_en") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([weekNumber, type])
  @@map("care_messages")
}

model MessageDelivery {
  id              String   @id @default(uuid()) @db.Uuid
  motherProfileId String   @map("mother_profile_id") @db.Uuid
  careMessageId   String   @map("care_message_id") @db.Uuid
  deliveredAt     DateTime @default(now()) @map("delivered_at")
  channel         String   @default("sms") @db.VarChar(20)

  @@index([motherProfileId, deliveredAt])
  @@map("message_deliveries")
}

model VideoCallSession {
  id                String        @id @default(uuid()) @db.Uuid
  motherProfileId   String        @map("mother_profile_id") @db.Uuid
  motherProfile     MotherProfile @relation(fields: [motherProfileId], references: [id])
  initiatedByUserId String?       @map("initiated_by_user_id") @db.Uuid
  scheduledAt       DateTime?     @map("scheduled_at")
  startedAt         DateTime?     @map("started_at")
  durationMinutes   Int?          @map("duration_minutes")
  channel           String        @default("whatsapp") @db.VarChar(20)
  notes             String?       @db.Text
  createdAt         DateTime      @default(now()) @map("created_at")

  @@index([motherProfileId, createdAt])
  @@map("video_call_sessions")
}

model KmcDailyLog {
  id                String        @id @default(uuid()) @db.Uuid
  motherProfileId   String        @map("mother_profile_id") @db.Uuid
  babyProfileId     String        @map("baby_profile_id") @db.Uuid
  logDate           DateTime      @map("log_date") @db.Date
  durationMinutes   Int           @map("duration_minutes")
  durationCategory  String        @map("duration_category") @db.VarChar(20) // 'SHORT' | 'EXTENDED' | 'LONG' | 'CONTINUOUS'
  provider          String?       @db.VarChar(20) // 'MOTHER' | 'FATHER' | 'OTHER_FAMILY'
  notes             String?       @db.Text
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  motherProfile     MotherProfile @relation(fields: [motherProfileId], references: [id])

  @@unique([motherProfileId, logDate])
  @@map("kmc_daily_logs")
}

model LearningArticle {
  id            String    @id @default(uuid()) @db.Uuid
  title         String
  slug          String    @unique @db.VarChar(100)
  category      String    @db.VarChar(50)
  tags          String[]
  body          String    @db.Text
  summary       String?   @db.Text
  status        String    @default("draft") @db.VarChar(20)
  authorId      String    @map("author_id") @db.Uuid
  author        User      @relation(fields: [authorId], references: [id])
  coverImageUrl String?   @map("cover_image_url")
  imageUrls     String[]  @map("image_urls")
  audioUrl      String?   @map("audio_url")
  videoUrl      String?   @map("video_url")
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([category])
  @@index([status, category])
  @@map("learning_articles")
}
